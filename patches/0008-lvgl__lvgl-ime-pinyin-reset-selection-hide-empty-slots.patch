@@ -785,21 +785,39 @@
     if(pinyin_ime->cand_str == NULL) {
-        return;
+        /* 无匹配（如退格到无结果）：隐藏候选面板，避免残留上一轮候选 */
+        lv_obj_add_flag(pinyin_ime->cand_panel, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+    if(pinyin_ime->cand_num == 0) {
+        /* 空词条（如拼音 i / o）：不显示空候选面板 */
+        lv_obj_add_flag(pinyin_ime->cand_panel, LV_OBJ_FLAG_HIDDEN);
+        return;
     }
 
     pinyin_ime->py_page = 0;
 
     for(uint8_t i = 0; i < LV_IME_PINYIN_CAND_TEXT_NUM; i++) {
         lv_memset(lv_pinyin_cand_str[i], 0x00, sizeof(lv_pinyin_cand_str[i]));
         lv_pinyin_cand_str[i][0] = ' ';
     }
 
     // fill buf
     for(uint8_t i = 0; (i < pinyin_ime->cand_num && i < LV_IME_PINYIN_CAND_TEXT_NUM); i++) {
         for(uint8_t j = 0; j < 3; j++) {
             lv_pinyin_cand_str[i][j] = pinyin_ime->cand_str[i * 3 + j];
         }
     }
 
+    /* 空槽设为 HIDDEN（占位保留，方向键/触摸导航自动跳过），并清除触摸选中残留 */
+    uint16_t valid = pinyin_ime->cand_num;
+    if(valid > LV_IME_PINYIN_CAND_TEXT_NUM) valid = LV_IME_PINYIN_CAND_TEXT_NUM;
+    lv_buttonmatrix_clear_button_ctrl_all(pinyin_ime->cand_panel,
+                                          LV_BUTTONMATRIX_CTRL_HIDDEN | LV_BUTTONMATRIX_CTRL_CHECKED);
+    for(uint8_t i = valid + 1; i <= LV_IME_PINYIN_CAND_TEXT_NUM; i++) {
+        lv_buttonmatrix_set_button_ctrl(pinyin_ime->cand_panel, i, LV_BUTTONMATRIX_CTRL_HIDDEN);
+    }
+    /* 每次新拼音输入：选中回第一个候选 */
+    lv_buttonmatrix_set_selected_button(pinyin_ime->cand_panel, 1);
+
     lv_obj_remove_flag(pinyin_ime->cand_panel, LV_OBJ_FLAG_HIDDEN);
     lv_obj_invalidate(pinyin_ime->cand_panel);
 }
@@ -836,10 +836,27 @@
     for(uint8_t i = 0; (i < pinyin_ime->cand_num && i < LV_IME_PINYIN_CAND_TEXT_NUM); i++) {
         if((remainder > 0) && (pinyin_ime->py_page == page_num)) {
             if(i >= remainder)
                 break;
         }
         for(uint8_t j = 0; j < 3; j++) {
             lv_pinyin_cand_str[i][j] = pinyin_ime->cand_str[offset + (i * 3) + j];
